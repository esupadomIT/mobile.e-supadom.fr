{
  "expo": {
    "name": "e-supadom",
    "slug": "esupadom-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "fr.esupadom.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "fr.esupadom.mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#1E5EFF"
        }
      ]
    ],
    "scheme": [
      "esupadom",
      "fr.esupadom.mobile",
      "com.googleusercontent.apps.942090691352-7hbssp31r0b9e3f7ec72ahoj91c653df"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "5fadb1b7-0275-4a6a-aefe-b5943a5b98c5"
      }
    },
    "owner": "guetat"
  }
}
